{
  "schemaVersion": 2,
  "name": "Malorian Arms Dioscuri",
  "game": "cyberpunk2077",
  "version": "1.2.0",
  "sources": [
    {
      "id": "archive-staging",
      "path": "archive-staging/Dioscuri",
      "kind": "archive-staging",
      "notes": "WolvenKit project packed into Dioscuri.archive: meshes, apps, sector, icons, materials, localization."
    },
    {
      "id": "archive-xl",
      "path": "archive-staging/Dioscuri.archive.xl",
      "kind": "xl",
      "notes": "Hand-authored ArchiveXL manifest: localization, factories, streaming block."
    },
    {
      "id": "tweaks",
      "path": "r6/tweaks/Dioscuri",
      "kind": "tweaks",
      "notes": "dioscuri.yaml: weapon, iconic mod, recipes, loot table and icon TweakDB records."
    },
    {
      "id": "scripts",
      "path": "scripts/Dioscuri",
      "kind": "scripts",
      "notes": "redscript: Dioscuri_TwoRoundReload.reds raises the two-round reload's anim variable while Dioscuri is drawn."
    },
    {
      "id": "cet",
      "path": "cet/DioscuriCache",
      "kind": "cet",
      "notes": "Author-only CET cleanup for legacy dev spawns — not shipped, no deploy target."
    },
    {
      "id": "blender",
      "path": "mesh-work",
      "kind": "blender",
      "notes": "dioscuri_kitbash_edit.blend (editable model) plus export_game_mesh_v2.py / render_icon_v2.py pipeline scripts."
    },
    {
      "id": "sources",
      "path": "sources",
      "kind": "sources",
      "notes": "Editable JSON sources for shipped binaries: sector, materials, cache_case entity, icons."
    }
  ],
  "build": {
    "outDir": "archive-staging",
    "steps": [
      {
        "step": "blender-export",
        "id": "mesh",
        "optional": true,
        "blend": "mesh-work/dioscuri_kitbash_edit.blend",
        "script": "mesh-work/export_game_mesh_v2.py",
        "out": "${stage}/dioscuri_body.glb"
      },
      {
        "step": "wolvenkit-import",
        "id": "mesh",
        "optional": true,
        "glb": "${stage}/dioscuri_body.glb",
        "base": "archive-staging/Dioscuri/mod/dioscuri/meshes/dioscuri_body.mesh",
        "outDir": "archive-staging/Dioscuri/mod/dioscuri/meshes"
      },
      {
        "step": "exec",
        "id": "sector-to-2.5",
        "command": "python",
        "args": [
          "tools/sector_231_to_25.py",
          "sources/sector/malorian.streamingsector.json",
          "${stage}/sector-2.5/malorian.streamingsector.json"
        ],
        "expectOutputs": [
          "${stage}/sector-2.5/malorian.streamingsector.json"
        ],
        "inputs": [
          "sources/sector/malorian.streamingsector.json",
          "tools/sector_231_to_25.py"
        ]
      },
      {
        "step": "exec",
        "id": "deserialize-sector",
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "tools/wk10.ps1",
          "convert",
          "deserialize",
          "${stage}/sector-2.5/malorian.streamingsector.json",
          "-o",
          "archive-staging/Dioscuri/malorian/sectors"
        ],
        "expectOutputs": [
          "archive-staging/Dioscuri/malorian/sectors/malorian.streamingsector"
        ],
        "freshOutputs": true,
        "inputs": [
          "${stage}/sector-2.5/malorian.streamingsector.json",
          "tools/wk10.ps1"
        ]
      },
      {
        "step": "stage",
        "id": "pack",
        "sources": [
          "archive-staging"
        ],
        "into": "Dioscuri"
      },
      {
        "step": "wolvenkit-pack",
        "from": "${stage}/pack/Dioscuri",
        "out": "Dioscuri.archive"
      },
      {
        "step": "verify-listing",
        "of": "Dioscuri.archive",
        "forbid": [
          "**/*.json",
          "!**/en-us.json"
        ]
      },
      {
        "step": "stage",
        "id": "dist",
        "sources": [
          {
            "output": "Dioscuri.archive",
            "into": "archive/pc/mod"
          },
          {
            "source": "archive-xl",
            "into": "archive/pc/mod"
          },
          {
            "source": "tweaks",
            "into": "r6/tweaks/Dioscuri"
          },
          {
            "source": "scripts",
            "into": "r6/scripts/Dioscuri"
          }
        ]
      },
      {
        "step": "zip",
        "from": "${stage}/dist",
        "name": "MalorianArmsDioscuri-${version}.zip"
      }
    ]
  },
  "deploy": {
    "waitMinutes": 0,
    "targets": [
      {
        "rootId": "archive",
        "from": "Dioscuri.archive",
        "locked": true,
        "backup": true
      },
      {
        "rootId": "archive",
        "from": "Dioscuri.archive.xl",
        "locked": false,
        "backup": true
      },
      {
        "rootId": "cet",
        "from": ".modwright/bridge/cp2077-cet/ModWrightBridge",
        "into": "ModWrightBridge",
        "variant": "withBridge",
        "locked": false,
        "backup": true,
        "prune": ["ModWrightBridge/**"]
      },
      {
        "rootId": "tweaks",
        "from": "tweaks",
        "into": "Dioscuri",
        "locked": false,
        "backup": true,
        "prune": ["Dioscuri/**"]
      },
      {
        "rootId": "redscript",
        "from": "scripts",
        "into": "Dioscuri",
        "locked": false,
        "backup": true,
        "prune": ["Dioscuri/**"]
      }
    ]
  },
  "dependencies": [
    {
      "id": "red4ext",
      "kind": "loader",
      "url": "https://www.nexusmods.com/cyberpunk2077/mods/2380"
    },
    {
      "id": "archivexl",
      "kind": "framework",
      "url": "https://www.nexusmods.com/cyberpunk2077/mods/4198"
    },
    {
      "id": "tweakxl",
      "kind": "framework",
      "url": "https://www.nexusmods.com/cyberpunk2077/mods/4197"
    },
    {
      "id": "redscript",
      "kind": "framework",
      "url": "https://www.nexusmods.com/cyberpunk2077/mods/1511",
      "notes": "Since the two-round reload (2026-10-28): scripts/Dioscuri raises the reload's anim variable while Dioscuri is drawn."
    },
    {
      "id": "wolvenkit-cli",
      "kind": "tool",
      "minVersion": "8.20",
      "notes": "Packs archive-staging/Dioscuri (build.ps1) and imports the Blender GLB export as a .mesh."
    },
    {
      "id": "blender",
      "kind": "tool",
      "minVersion": "5.1",
      "notes": "Cyberpunk IO Suite required for the join-by-material GLB export (export_game_mesh_v2.py)."
    }
  ],
  "toolchain": {
    "wolvenkit-cli": "C:/Users/jtrac/dev/tools/WolvenKit.Console/WolvenKit.CLI.exe",
    "blender": "C:/Program Files/Blender Foundation/Blender 5.1/blender.exe"
  },
  "publish": [
    {
      "target": "nexus",
      "id": "32801",
      "notes": "https://www.nexusmods.com/cyberpunk2077/mods/32801"
    },
    {
      "target": "zip",
      "include": [
        "archive/**",
        "r6/**"
      ],
      "notes": "build.ps1 -Dist stages archive/pc/mod + r6/tweaks/Dioscuri into dist/MalorianArmsDioscuri-<version>.zip."
    }
  ]
}
